# CYBERDECK // dunst
# incoming transmissions. hard edges, neon frames, no mercy.

[global]
font = Terminus 10
frame_width = 2
frame_color = "#05d9e8"
corner_radius = 0
padding = 8
horizontal_padding = 10
origin = top-right
offset = 12x30
format = "<b>%s</b>\n%b"

[urgency_low]
background = "#0a0a12"
foreground = "#05d9e8"
timeout = 5

[urgency_normal]
background = "#0a0a12"
foreground = "#d1f7ff"
timeout = 8

[urgency_critical]
background = "#0a0a12"
foreground = "#ff2a6d"
frame_color = "#ff2a6d"
timeout = 0
